__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/
.venv/
venv/

# generated data / runs (large, non-deterministic paths, never committed)
data_cache/*
!data_cache/.gitkeep
runs/
kaggle_working/
*.npz
*.memmap
*.dat

# paper artifacts are entirely regenerated by `aggregate`; keep the dirs but
# not their generated contents (including rehearsal placeholder tables).
paper_artifacts/figures/*.png
paper_artifacts/figures/*.pdf
!paper_artifacts/figures/.gitkeep
paper_artifacts/tables/*.tex
!paper_artifacts/tables/.gitkeep
paper_artifacts/paper_facts.json
paper_artifacts/results_summary.md
lrmc_kaggle_bundle.zip
alerts.jsonl

# OS
.DS_Store
Thumbs.db
